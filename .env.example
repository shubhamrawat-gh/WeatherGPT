# WeatherGPT Environment Configuration
# OpenRouter API Key for Conversational AI Intelligence (Get key at https://openrouter.ai/keys)
VITE_OPENROUTER_API_KEY=your_openrouter_api_key_here

# Gemini Live Voice API Key (Used strictly server-side by server/relay.mjs, never exposed to browser)
GEMINI_API_KEY=your_gemini_api_key_here

# Mapbox Access Token for Climate Map GIS Layer
VITE_MAPBOX_TOKEN=your_mapbox_public_token_here
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_public_token_here

